<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_product_tree_view" model="ir.ui.view">
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view" />
        <field name="arch" type="xml">
            <field name="default_code" position="after">
                <field name="plm_revision" optional="show" />
            </field>
        </field>
    </record>
    <record id="product_normal_form_view" model="ir.ui.view">
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view" />
        <field name="arch" type="xml">
            <field name="default_code" position="after">
                <field name="plm_revision" invisible="not engineering_code" />
            </field>
        </field>
    </record>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button" name="action_plm_release_impact" type="object"
                        icon="east" string="Open orders" invisible="not engineering_code"
                        help="Open manufacturing and purchase orders that still use an older revision" />
            </div>
            <field name="categ_id" position="after">
                <field name="engineering_revision" string="Revision" readonly="1" invisible="not engineering_code" />
                <field name="revision_effective_date" invisible="not engineering_code" />
                <field name="revision_phase_out" invisible="not engineering_code" />
            </field>
        </field>
    </record>
</odoo>
